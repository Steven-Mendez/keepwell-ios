// Base.xcconfig — settings shared by every configuration.
// Each environment (Debug/Staging/Release) includes this file and overrides what it needs.

// Helper: xcconfig trims leading whitespace, so use $(SPACE) to prepend one.
EMPTY =
SPACE = $(EMPTY) $(EMPTY)

// Identity
BASE_BUNDLE_ID = com.stevenmendez.keepwell
APP_BUNDLE_ID = $(BASE_BUNDLE_ID)$(BUNDLE_ID_SUFFIX)
WIDGETS_BUNDLE_ID = $(APP_BUNDLE_ID).widgets
// Shared by the app and its widgets; per configuration so Debug never shows Release data.
APP_GROUP_ID = group.$(APP_BUNDLE_ID)
APP_DISPLAY_NAME = Keepwell$(APP_NAME_SUFFIX)

// Versioning (MARKETING_VERSION = user-visible version; CURRENT_PROJECT_VERSION = build)
MARKETING_VERSION = 1.0
CURRENT_PROJECT_VERSION = 1

// The app's entitlements. Personal (free) teams can't sign Push, so Local.xcconfig can
// point this at KeepwellPersonalTeam.entitlements, which keeps only the App Group the widgets need.
APP_ENTITLEMENTS = App/Resources/Keepwell.entitlements

// Keepwell API (account and sync). Empty keeps the app local-only. Set it per environment or in
// Local.xcconfig; xcconfig treats `//` as a comment, so write https:/$()/api.example.com.
// Production has no domain of its own: the web app forwards the API's paths (keepwell-api ADR 0009).
API_BASE_URL = https:/$()/keepwell-web.vercel.app
// The web app's host: passkeys' relying party, shared through the associated domain.
WEB_HOST = keepwell-web.vercel.app

// Platform and language
IPHONEOS_DEPLOYMENT_TARGET = 26.0
TARGETED_DEVICE_FAMILY = 1
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
SWIFT_UPCOMING_FEATURE_EXISTENTIAL_ANY = YES
SWIFT_TREAT_WARNINGS_AS_ERRORS = NO
ENABLE_USER_SCRIPT_SANDBOXING = YES
ENABLE_MODULE_VERIFIER = NO
LOCALIZATION_PREFERS_STRING_CATALOGS = YES
SWIFT_EMIT_LOC_STRINGS = YES

// Signing: keep DEVELOPMENT_TEAM empty in the repo. Each developer sets their own in
// Configs/Local.xcconfig (git-ignored), e.g. `DEVELOPMENT_TEAM = ABCDE12345`.
CODE_SIGN_STYLE = Automatic
DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
