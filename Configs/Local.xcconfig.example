// Copy this file to Configs/Local.xcconfig (git-ignored) for your local settings.
DEVELOPMENT_TEAM = ABCDE12345

// With a personal (free) team, uncomment this: those teams can't sign iCloud or Push, and the
// App Group must stay signed or the widgets never see the app's data. Never override
// CODE_SIGN_ENTITLEMENTS on the command line: that also strips the widget extension's App Group.
// APP_ENTITLEMENTS = App/Resources/KeepwellPersonalTeam.entitlements
