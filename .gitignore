# ── Local design material: NEVER committed ───────────────────────────────────
/design/

# ── Project generated by XcodeGen (source of truth: project.yml) ─────────────
# Package.resolved is committed at the repo root instead (see `make resolve`).
*.xcodeproj/
*.xcworkspace/

# ── Local configuration ─────────────────────────────────────────────────────
Configs/Local.xcconfig
.mise.local.toml
lefthook-local.yml
.claude/settings.local.json

# ── Signing and secrets (never in the repo) ─────────────────────────────────
*.p12
*.p8
*.cer
*.mobileprovision
*.provisionprofile
.env
.env.*

# ── Xcode: build artifacts ──────────────────────────────────────────────────
build/
DerivedData/
*.xcarchive
*.ipa
*.dSYM
*.dSYM.zip
*.xcresult
*.profraw
*.profdata
*.hmap
*.moved-aside

# ── Xcode: user state ───────────────────────────────────────────────────────
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
timeline.xctimeline

# ── Swift Package Manager ───────────────────────────────────────────────────
# Local packages don't commit their own Package.resolved: the app pins it at the root.
.build/
.swiftpm/
Packages/*/Package.resolved

# ── macOS / editors / merges ────────────────────────────────────────────────
.DS_Store
.AppleDouble
.LSOverride
._*
.idea/
.vscode/
*.swp
*~
*.orig
*.rej
