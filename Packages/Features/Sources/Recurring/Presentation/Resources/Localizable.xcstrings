    "Add recurring" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agregar recurrente"
          }
        }
      }
    },
    "Add rent, a salary or a subscription once. Each time it's due, a draft waits on that day for you to confirm." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agrega el alquiler, un salario o una suscripción una sola vez. Cada vez que toque, un borrador te espera ese día para que lo confirmes."
          }
        }
      }
    },
