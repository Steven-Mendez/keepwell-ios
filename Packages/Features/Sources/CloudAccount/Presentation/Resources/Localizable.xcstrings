{
  "sourceLanguage" : "en",
  "strings" : {
    "Account" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta"
          }
        }
      }
    },
    "An account syncs this iPhone with Keepwell on the web. Without one, your data stays only here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta sincroniza este iPhone con Keepwell en la web. Sin ella, tus datos se quedan solo aquí."
          }
        }
      }
    },
    "Assistants disconnected" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asistentes desconectados"
          }
        }
      }
    },
