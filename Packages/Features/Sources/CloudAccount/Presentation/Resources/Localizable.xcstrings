            "value" : "Sincronización en pausa"
          }
        }
      }
    },
    "Sync with the web and Claude come with a one-time coffee. Everything else stays free and works on this iPhone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
