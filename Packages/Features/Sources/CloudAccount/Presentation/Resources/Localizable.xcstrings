    "Choose which data to keep" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige qué datos conservar"
          }
        }
      }
    },
    "Choose which to keep. The other is replaced, and this can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige cuáles conservar. Los otros se reemplazan y no se puede deshacer."
          }
        }
      }
    },
    "Claude and other assistants lose access to your account at once." : {
      "localizations" : {
