          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizando…"
          }
        }
      }
    },
    "Thank you for the coffee. Sync and Claude are on." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gracias por el café. La sincronización y Claude ya están activos."
          }
        }
      }
    },
    "That invitation is not valid. It may have expired or been used." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa invitación no es válida. Puede que haya caducado o ya se haya usado."
          }
        }
      }
    },
    "The App Store couldn't complete the purchase. Try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El App Store no pudo completar la compra. Inténtalo de nuevo."
          }
        }
      }
    },
    "The coffee isn't available in the App Store right now. Check your connection and try again later." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El café no está disponible en el App Store en este momento. Revisa tu conexión e inténtalo más tarde."
          }
        }
      }
    },
    "This iPhone and your account have different data" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este iPhone y tu cuenta tienen datos distintos"
          }
        }
      }
    },
