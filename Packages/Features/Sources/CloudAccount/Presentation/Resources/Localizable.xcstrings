{
  "sourceLanguage" : "en",
  "strings" : {
    "Account" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuenta"
          }
        }
      }
    },
    "An account syncs this iPhone with Keepwell on the web. Without one, your data stays only here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cuenta sincroniza este iPhone con Keepwell en la web. Sin ella, tus datos se quedan solo aquí."
          }
        }
      }
    },
    "Couldn't reach Keepwell. Try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar con Keepwell. Inténtalo de nuevo."
          }
        }
      }
    },
    "Couldn't sign in with Apple. Try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo iniciar sesión con Apple. Inténtalo de nuevo."
          }
        }
      }
    },
    "Couldn't sync. Keepwell will try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo sincronizar. Keepwell lo intentará de nuevo."
          }
        }
      }
    },
    "Delete account" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar cuenta"
          }
        }
      }
    },
    "Delete your Keepwell account?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Eliminar tu cuenta de Keepwell?"
          }
        }
      }
    },
    "Every iPhone and browser signed in to this account will need to sign in again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada iPhone y navegador con esta cuenta tendrá que volver a iniciar sesión."
          }
        }
      }
    },
    "Keepwell accounts are invite-only for now." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por ahora las cuentas de Keepwell son solo por invitación."
          }
        }
      }
    },
    "Offline. Changes sync when you're back online." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin conexión. Los cambios se sincronizan al volver a estar en línea."
          }
        }
      }
    },
    "Sign out" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar sesión"
          }
        }
      }
    },
    "Sign out everywhere" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar en todos"
          }
        }
      }
    },
    "Sign out on all devices" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cerrar sesión en todos los dispositivos"
          }
        }
      }
    },
    "Sign out on all devices?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cerrar sesión en todos los dispositivos?"
          }
        }
      }
    },
    "Sync included during early access." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronización incluida en el acceso anticipado."
          }
        }
      }
    },
    "Sync isn't included in your plan. Everything keeps working on this iPhone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sincronización no está incluida en tu plan. Todo sigue funcionando en este iPhone."
          }
        }
      }
    },
    "Syncing…" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sincronizando…"
          }
        }
      }
    },
    "Up to date." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al día."
          }
        }
      }
    },
    "You were signed out. Sign in again to keep syncing." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerró tu sesión. Vuelve a iniciarla para seguir sincronizando."
          }
        }
      }
    },
    "You're signed out everywhere at once and your synced data is erased from Keepwell's servers. Backups keep it up to 35 more days. What's on this iPhone stays here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cierra tu sesión en todos lados al instante y tus datos sincronizados se borran de los servidores de Keepwell. Las copias de seguridad los conservan hasta 35 días más. Lo que hay en este iPhone se queda aquí."
          }
        }
      }
    }
  },
  "version" : "1.0"
}
