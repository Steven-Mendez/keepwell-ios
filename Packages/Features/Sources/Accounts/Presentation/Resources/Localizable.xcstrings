    "The account, its card and its %lld movements are deleted, including transfers with your other accounts, so their balances change too. This can't be undone." : {
      "localizations" : {
        "en" : {
          "variations" : {
            "plural" : {
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
