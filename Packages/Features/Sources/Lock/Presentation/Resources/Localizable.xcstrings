    "Six digits to open Keepwell when Face ID can't. It's kept only on this iPhone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seis dígitos para abrir Keepwell cuando Face ID no pueda. Solo se guarda en este iPhone."
          }
        }
      }
    },
    "Tap to use Face ID" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
