    "We couldn't save your data. Try again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pudimos guardar tus datos. Intenta de nuevo."
          }
        }
      }
    },
    "We'll use it to greet you and show it on your cards. It's only stored on this iPhone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo usaremos para saludarte y mostrarlo en tus tarjetas. Solo se guarda en este iPhone."
          }
        }
      }
    },
    "What's your name?" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cómo te llamas?"
          }
        }
      }
    },
