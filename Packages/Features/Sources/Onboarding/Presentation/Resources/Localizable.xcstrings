        }
      }
    },
    "Your balances are yours alone. Lock the app so only you can open it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus saldos son solo tuyos. Bloquea la app para que solo tú puedas abrirla."
          }
        }
      }
    },
    "Your data lives on your iPhone. A Keepwell account to sync with the web is optional, and you can add it later in Settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus datos viven en tu iPhone. Una cuenta Keepwell para sincronizar con la web es opcional, y puedes añadirla después en Ajustes."
          }
        }
      }
    },
