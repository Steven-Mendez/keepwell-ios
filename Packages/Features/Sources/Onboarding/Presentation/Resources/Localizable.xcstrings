    },
    "With today's balance. Credit cards start with what you owe." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con su saldo de hoy. Las tarjetas de crédito empiezan con lo que debes."
